# ==========================================
# macOS System Files (Apple Silicon / Intel)
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon?
Network Trash Folder
Temporary Items

# ==========================================
# Linux & Windows System Files
# ==========================================
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# ==========================================
# Temporary, Scratch & Local Runtime Files
# ==========================================
*.tmp
*.temp
*.swp
*.swo
*~
cookies.txt
*cookies*.txt
scratch/

# ==========================================
# Logs & Process Dumps
# ==========================================
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ==========================================
# Node / Frontend Artifacts
# ==========================================
node_modules/
.npm/
.package-lock.json

# Generated CSS (built via Tailwind)
src/main/webapp/css/style.css

# ==========================================
# Java / Build Artifacts & Compiled Classes
# ==========================================
dist/
build/
bin/
target/
out/
*.class
src/main/webapp/WEB-INF/classes/
WEB-INF/classes/
*.war
*.ear
*.zip
*.tar.gz

# Downloaded JAR dependencies (managed by setup scripts)
src/main/webapp/WEB-INF/lib/*.jar
!src/main/webapp/WEB-INF/lib/.gitkeep

# ==========================================
# Databases & Local Volume Mounts
# ==========================================
*.db
*.sqlite
*.sqlite3
oracle-data/

